{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://evemisslab.com/pncw/readiness-result/v1.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","requestId","ready","checks","sourceSnapshot","capabilitySnapshot"],
  "properties":{
    "schema":{"const":"pncw-readiness-result/v1"},
    "requestId":{"type":"string","minLength":1},
    "ready":{"type":"boolean"},
    "checks":{"type":"array","items":{"$ref":"#/$defs/check"}},
    "blockingError":{"$ref":"#/$defs/errorEnvelope"},
    "sourceSnapshot":{"$ref":"#/$defs/sourceIdentity"},
    "capabilitySnapshot":{"type":"object","additionalProperties":false,"required":["source","surface"],"properties":{"source":{"$ref":"#/$defs/sourceCapabilities"},"surface":{"$ref":"#/$defs/surfaceCapabilities"}}}
  },
  "$defs":{
    "check":{"type":"object","additionalProperties":false,"required":["name","passed"],"properties":{"name":{"type":"string","minLength":1},"passed":{"type":"boolean"},"detail":{"type":"string","minLength":1}}},
    "sourceIdentity":{"type":"object","additionalProperties":false,"required":["authority","sourceId","revision","digest"],"properties":{"authority":{"type":"string","minLength":1},"sourceId":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":0},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}},
    "sourceCapabilities":{"type":"object","additionalProperties":false,"required":["provider","providerVersion","observationModes","carrierProfiles","partialRead","canonicalMutation"],"properties":{"provider":{"type":"string","minLength":1},"providerVersion":{"type":"string","minLength":1},"observationModes":{"type":"array","items":{"enum":["human_preview","machine_carrier","structured_manifest"]}},"carrierProfiles":{"type":"array","items":{"type":"string","minLength":1}},"partialRead":{"type":"boolean"},"canonicalMutation":{"const":false}}},
    "surfaceCapabilities":{"type":"object","additionalProperties":false,"required":["provider","providerVersion","portalSchema","readOnlyProjection","canonicalMutation"],"properties":{"provider":{"type":"string","minLength":1},"providerVersion":{"type":"string","minLength":1},"portalSchema":{"type":"string","minLength":1},"readOnlyProjection":{"type":"boolean"},"canonicalMutation":{"const":false}}},
    "errorEnvelope":{"type":"object","additionalProperties":false,"required":["schema","code","stage","retryable","source","message"],"properties":{"schema":{"const":"pncw-error/v1"},"code":{"enum":["INVALID_REQUEST","UNAUTHORIZED","UNSUPPORTED","SOURCE_UNAVAILABLE","STALE_SOURCE","INTEGRITY_FAILURE","MATERIALIZATION_FAILED","SURFACE_UNAVAILABLE","VERSION_CONFLICT","VERIFICATION_FAILED","INVALID_TRANSITION","ALREADY_VISIBLE","ABORTED"]},"stage":{"enum":["REQUEST","SOURCE","READINESS","MATERIALIZATION","SURFACE","MANIFEST","VERIFICATION","VISIBILITY","RECOVERY"]},"retryable":{"type":"boolean"},"source":{"enum":["pncw","hdsrc","mrmic"]},"message":{"type":"string","minLength":1},"causeRef":{"type":"string","minLength":1}}}
  }
}
